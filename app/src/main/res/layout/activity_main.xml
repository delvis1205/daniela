<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/room_background">

    <ImageView
        android:id="@+id/daniela_avatar"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/daniela_avatar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btn_vestir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vestir"
            android:layout_margin="5dp"
            android:backgroundTint="#FF4081" />

        <Button
            android:id="@+id/btn_cozinhar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cozinhar"
            android:layout_margin="5dp"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btn_jogos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jogos"
            android:layout_margin="5dp"
            android:backgroundTint="#2196F3" />

        <Button
            android:id="@+id/btn_loja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loja"
            android:layout_margin="5dp"
            android:backgroundTint="#FFC107" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_moedas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moedas: 100"
        android:textSize="20sp"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
