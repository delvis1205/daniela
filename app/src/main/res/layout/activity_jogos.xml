<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0FFFF">

    <TextView
        android:id="@+id/tv_jogos_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minijogos da Daniela"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        app:layout_constraintTop_toBottomOf="@id/tv_jogos_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_jogo_memoria"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Memória"
            android:layout_margin="10dp"
            android:backgroundTint="#FF7F50" />

        <Button
            android:id="@+id/btn_jogo_estrelas"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Pegar Estrelas"
            android:layout_margin="10dp"
            android:backgroundTint="#DA70D6" />

        <Button
            android:id="@+id/btn_jogo_puzzle"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Puzzle"
            android:layout_margin="10dp"
            android:backgroundTint="#32CD32" />

        <Button
            android:id="@+id/btn_jogo_rapido"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Cozinha Rápida"
            android:layout_margin="10dp"
            android:backgroundTint="#1E90FF" />

    </GridLayout>

    <Button
        android:id="@+id/btn_voltar_jogos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
